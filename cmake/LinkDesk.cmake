if(MSVC)
    add_compile_options(/utf-8)
endif()
set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
find_package(Qt6 6.5 REQUIRED COMPONENTS Widgets Network Concurrent)
qt_standard_project_setup()
add_library(linkdesk_core STATIC ${LINKDESK_ROOT}/src/desktopcodec.cpp ${LINKDESK_ROOT}/src/desktopcodec.h ${LINKDESK_ROOT}/src/adminpassword.cpp ${LINKDESK_ROOT}/src/adminpassword.h ${LINKDESK_ROOT}/src/remote.cpp ${LINKDESK_ROOT}/src/remote.h ${LINKDESK_ROOT}/src/hostbackend.h ${LINKDESK_ROOT}/src/protocol.cpp ${LINKDESK_ROOT}/src/protocol.h ${LINKDESK_ROOT}/src/input.cpp ${LINKDESK_ROOT}/src/input.h ${LINKDESK_ROOT}/src/relay.cpp ${LINKDESK_ROOT}/src/relay.h)
target_include_directories(linkdesk_core PUBLIC "${LINKDESK_ROOT}/src")
target_sources(linkdesk_core PRIVATE "${LINKDESK_ROOT}/src/videocodec.cpp" "${LINKDESK_ROOT}/src/streamscheduler.cpp")
target_sources(linkdesk_core PRIVATE "${LINKDESK_ROOT}/src/filetransfer.cpp" "${LINKDESK_ROOT}/src/filetransfer.h" "${LINKDESK_ROOT}/src/systemsettings.cpp")
target_link_libraries(linkdesk_core PUBLIC Qt6::Widgets Qt6::Network Qt6::Concurrent)
qt_add_executable(LinkDesk MACOSX_BUNDLE WIN32
    ${LINKDESK_ROOT}/src/main.cpp ${LINKDESK_ROOT}/src/mainwindow.cpp ${LINKDESK_ROOT}/src/mainwindow.h
    ${LINKDESK_ROOT}/src/viewer.cpp ${LINKDESK_ROOT}/src/viewer.h)
target_sources(LinkDesk PRIVATE ${LINKDESK_ROOT}/src/connectionlist.cpp ${LINKDESK_ROOT}/src/connectionlist.h)
target_link_libraries(LinkDesk PRIVATE linkdesk_core)
qt_add_resources(LinkDesk branding PREFIX "/brand" BASE "${LINKDESK_ROOT}/assets/icons" FILES "${LINKDESK_ROOT}/assets/icons/linkdesk.png")
if(APPLE)
    enable_language(OBJCXX)
    set_target_properties(linkdesk_core PROPERTIES OBJCXX_STANDARD 17 OBJCXX_STANDARD_REQUIRED ON)
    target_sources(LinkDesk PRIVATE "${LINKDESK_ROOT}/assets/icons/LinkDesk.icns")
    set_source_files_properties("${LINKDESK_ROOT}/assets/icons/LinkDesk.icns" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
    set_target_properties(LinkDesk PROPERTIES MACOSX_BUNDLE_ICON_FILE LinkDesk.icns)
    target_sources(linkdesk_core PRIVATE "${LINKDESK_ROOT}/ForMac/src/input_mac.cpp" "${LINKDESK_ROOT}/ForMac/src/platform_mac.cpp")
    target_sources(linkdesk_core PRIVATE "${LINKDESK_ROOT}/ForMac/src/video_mac.cpp" "${LINKDESK_ROOT}/ForMac/src/capture_mac.mm")
    set_source_files_properties("${LINKDESK_ROOT}/ForMac/src/capture_mac.mm" PROPERTIES COMPILE_FLAGS "-fobjc-arc")
    target_link_libraries(linkdesk_core PUBLIC "-framework ApplicationServices" "-framework Security" "-framework ScreenCaptureKit" "-framework VideoToolbox" "-framework CoreMedia" "-framework CoreVideo" "-framework AppKit")
    set_target_properties(LinkDesk PROPERTIES MACOSX_BUNDLE_INFO_PLIST "${LINKDESK_ROOT}/ForMac/Info.plist")
elseif(WIN32)
    add_library(linkdesk_service_support STATIC "${LINKDESK_ROOT}/ForWin/service/native.cpp" "${LINKDESK_ROOT}/ForWin/service/pipe.cpp")
    target_include_directories(linkdesk_service_support PUBLIC "${LINKDESK_ROOT}/ForWin/service")
    target_link_libraries(linkdesk_service_support PUBLIC linkdesk_core wtsapi32 userenv shell32 advapi32)
    qt_add_executable(LinkDeskService WIN32 "${LINKDESK_ROOT}/ForWin/service/main.cpp" "${LINKDESK_ROOT}/ForWin/service/backend.cpp" "${LINKDESK_ROOT}/ForWin/service/backend.h")
    target_link_libraries(LinkDeskService PRIVATE linkdesk_service_support)
    qt_add_executable(LinkDeskWorker WIN32 "${LINKDESK_ROOT}/ForWin/service/worker.cpp")
    target_link_libraries(LinkDeskWorker PRIVATE linkdesk_service_support)
    qt_add_executable(LinkDeskServiceSetup WIN32 "${LINKDESK_ROOT}/ForWin/service/setup.cpp")
    target_link_libraries(LinkDeskServiceSetup PRIVATE linkdesk_service_support)
    target_link_libraries(LinkDesk PRIVATE linkdesk_service_support)
    target_sources(LinkDesk PRIVATE "${LINKDESK_ROOT}/ForWin/service/gui.cpp")
    enable_language(RC)
    configure_file("${LINKDESK_ROOT}/ForWin/resources/LinkDesk.rc.in" "${CMAKE_CURRENT_BINARY_DIR}/LinkDesk.rc" @ONLY)
    target_sources(LinkDesk PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/LinkDesk.rc")
    set_source_files_properties("${CMAKE_CURRENT_BINARY_DIR}/LinkDesk.rc" PROPERTIES OBJECT_DEPENDS "${LINKDESK_ROOT}/assets/icons/LinkDesk.ico")
    target_sources(linkdesk_core PRIVATE "${LINKDESK_ROOT}/ForWin/src/input_win.cpp" "${LINKDESK_ROOT}/ForWin/src/platform_win.cpp" "${LINKDESK_ROOT}/ForWin/src/capture_dxgi.cpp")
    target_sources(linkdesk_core PRIVATE "${LINKDESK_ROOT}/ForWin/src/video_win.cpp")
    target_link_libraries(linkdesk_core PUBLIC user32 gdi32 crypt32 ncrypt advapi32 d3d11 dxgi dxguid mfuuid ole32 oleaut32 strmiids)
    target_compile_definitions(linkdesk_core PRIVATE UNICODE _UNICODE)
    if(MSVC)
        target_compile_options(linkdesk_core PRIVATE /utf-8)
        target_compile_options(LinkDesk PRIVATE /utf-8)
    endif()
else()
    message(FATAL_ERROR "LinkDesk client currently supports macOS and Windows")
endif()
include(CTest)
if(BUILD_TESTING)
    find_package(Qt6 REQUIRED COMPONENTS Test)
    qt_add_executable(singleinstance_test ${LINKDESK_ROOT}/tests/singleinstance_test.cpp)
    target_include_directories(singleinstance_test PRIVATE "${LINKDESK_ROOT}/src")
    target_link_libraries(singleinstance_test PRIVATE Qt6::Network)
    add_test(NAME singleinstance COMMAND singleinstance_test)
    set_tests_properties(singleinstance PROPERTIES TIMEOUT 30)
    qt_add_executable(shutdown_test ${LINKDESK_ROOT}/tests/shutdown_test.cpp
        ${LINKDESK_ROOT}/src/mainwindow.cpp ${LINKDESK_ROOT}/src/connectionlist.cpp ${LINKDESK_ROOT}/src/viewer.cpp)
    target_link_libraries(shutdown_test PRIVATE linkdesk_core Qt6::Test)
    if(WIN32)
        target_link_libraries(shutdown_test PRIVATE linkdesk_service_support)
        target_sources(shutdown_test PRIVATE "${LINKDESK_ROOT}/ForWin/service/gui.cpp")
    endif()
    add_test(NAME shutdown COMMAND shutdown_test)
    set_tests_properties(shutdown PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 30)
    qt_add_executable(file_probe ${LINKDESK_ROOT}/tests/file_probe.cpp)
    target_link_libraries(file_probe PRIVATE linkdesk_core)
    qt_add_executable(streaming_test ${LINKDESK_ROOT}/tests/streaming_test.cpp)
    target_link_libraries(streaming_test PRIVATE linkdesk_core Qt6::Test)
    add_test(NAME streaming COMMAND streaming_test)
    set_tests_properties(streaming PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    qt_add_executable(desktop_benchmark ${LINKDESK_ROOT}/tests/desktop_benchmark.cpp)
    target_link_libraries(desktop_benchmark PRIVATE linkdesk_core)
    qt_add_executable(desktopcodec_test ${LINKDESK_ROOT}/tests/desktopcodec_test.cpp)
    target_link_libraries(desktopcodec_test PRIVATE linkdesk_core Qt6::Test)
    add_test(NAME desktopcodec COMMAND desktopcodec_test)
    set_tests_properties(desktopcodec PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    qt_add_executable(adminpassword_test ${LINKDESK_ROOT}/tests/adminpassword_test.cpp)
    target_link_libraries(adminpassword_test PRIVATE linkdesk_core Qt6::Test)
    add_test(NAME adminpassword COMMAND adminpassword_test)
    qt_add_executable(viewer_test ${LINKDESK_ROOT}/tests/viewer_test.cpp ${LINKDESK_ROOT}/src/viewer.cpp ${LINKDESK_ROOT}/src/viewer.h)
    target_link_libraries(viewer_test PRIVATE linkdesk_core Qt6::Test)
    add_test(NAME viewer COMMAND viewer_test)
    set_tests_properties(viewer PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    qt_add_executable(service_probe "${LINKDESK_ROOT}/tests/service_probe.cpp" "${LINKDESK_ROOT}/src/viewer.cpp" "${LINKDESK_ROOT}/src/viewer.h")
    target_link_libraries(service_probe PRIVATE linkdesk_core)
    qt_add_executable(relay_probe "${LINKDESK_ROOT}/tests/relay_probe.cpp" "${LINKDESK_ROOT}/src/viewer.cpp" "${LINKDESK_ROOT}/src/viewer.h")
    target_link_libraries(relay_probe PRIVATE linkdesk_core Qt6::Test)
    qt_add_executable(protocol_test ${LINKDESK_ROOT}/tests/protocol_test.cpp ${LINKDESK_ROOT}/src/protocol.cpp ${LINKDESK_ROOT}/src/protocol.h)
    target_include_directories(protocol_test PRIVATE "${LINKDESK_ROOT}/src")
    target_link_libraries(protocol_test PRIVATE Qt6::Network Qt6::Test)
    add_test(NAME protocol COMMAND protocol_test)
    qt_add_executable(connection_test ${LINKDESK_ROOT}/tests/connection_test.cpp)
    target_link_libraries(connection_test PRIVATE linkdesk_core Qt6::Test)
    add_test(NAME connection COMMAND connection_test)
    set_tests_properties(connection PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen")
    if(WIN32)
        qt_add_executable(service_gui_probe "${LINKDESK_ROOT}/ForWin/tests/service_gui_probe.cpp" "${LINKDESK_ROOT}/src/mainwindow.cpp" "${LINKDESK_ROOT}/src/mainwindow.h" "${LINKDESK_ROOT}/src/viewer.cpp" "${LINKDESK_ROOT}/src/viewer.h" "${LINKDESK_ROOT}/src/connectionlist.cpp" "${LINKDESK_ROOT}/src/connectionlist.h" "${LINKDESK_ROOT}/ForWin/service/gui.cpp")
        target_link_libraries(service_gui_probe PRIVATE linkdesk_service_support)
        qt_add_executable(service_testtool "${LINKDESK_ROOT}/ForWin/tests/service_testtool.cpp")
        target_link_libraries(service_testtool PRIVATE linkdesk_service_support)
        qt_add_executable(windows_platform_test "${LINKDESK_ROOT}/ForWin/tests/windows_platform_test.cpp")
        target_link_libraries(windows_platform_test PRIVATE linkdesk_core Qt6::Test)
        add_test(NAME windows_platform COMMAND windows_platform_test)
        set_tests_properties(windows_platform PROPERTIES TIMEOUT 60)
    endif()
    if(APPLE OR WIN32)
        find_package(Python3 3.10 COMPONENTS Interpreter QUIET)
        if(NOT Python3_FOUND)
            set(Python3_EXECUTABLE "")
        endif()
        qt_add_executable(relay_test ${LINKDESK_ROOT}/tests/relay_test.cpp)
        target_sources(relay_test PRIVATE ${LINKDESK_ROOT}/src/connectionlist.cpp ${LINKDESK_ROOT}/src/connectionlist.h ${LINKDESK_ROOT}/src/viewer.cpp ${LINKDESK_ROOT}/src/viewer.h)
        target_link_libraries(relay_test PRIVATE linkdesk_core Qt6::Test)
        target_compile_definitions(relay_test PRIVATE
            LINKDESK_TEST_PYTHON="${Python3_EXECUTABLE}"
            LINKDESK_SERVER_SOURCE="${LINKDESK_ROOT}/server/relay_server.py")
        add_test(NAME relay COMMAND relay_test)
        set_tests_properties(relay PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 120)
    endif()
endif()
install(TARGETS LinkDesk BUNDLE DESTINATION . RUNTIME DESTINATION bin)
set(LINKDESK_SERVER_CONFIG "" CACHE FILEPATH "Optional server JSON packaged with the client")
if(APPLE AND LINKDESK_SERVER_CONFIG)
    target_sources(LinkDesk PRIVATE "${LINKDESK_SERVER_CONFIG}")
    set_source_files_properties("${LINKDESK_SERVER_CONFIG}" PROPERTIES MACOSX_PACKAGE_LOCATION Resources)
    add_custom_command(TARGET LinkDesk POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy
        "${LINKDESK_SERVER_CONFIG}" "$<TARGET_BUNDLE_DIR:LinkDesk>/Contents/Resources/server.json")
endif()

if(WIN32 AND LINKDESK_SERVER_CONFIG)
    add_custom_command(TARGET LinkDesk POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_if_different
        "${LINKDESK_SERVER_CONFIG}" "$<TARGET_FILE_DIR:LinkDesk>/server.json")
endif()
